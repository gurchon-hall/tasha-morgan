      "cards": []
    },
    "fr": {
      "name": "Perfectionniste",
      "text": "Archétype.\nMettez cette carte sur un vampire que vous contrôlez. Une fois par tour, ce vampire peut gagner 1 point de sang après avoir effectué une action réussie durant laquelle aucune carte de réaction n'a été jouée. Un vampire ne peut avoir qu'un seul archétype.",
      "flavor": "La perfection est la loi du ciel ; y aspirer, la loi de l'homme.\nJohann Wolfgang von Goethe",
      "draft": "",
      "url": "https://static.krcg.org/card/fr/perfectionist.jpg",
