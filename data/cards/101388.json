  "i18n": {
    "es": {
      "name": "Perfeccionista",
      "text": "Arquetipo.\nPonle esta carta a un vampiro que controles. Una vez por turno, este vampiro puede ganar 1 de sangre tras realizar una acción exitosa durante la cual no se hayan jugado cartas de reacción.",
      "flavor": "",
