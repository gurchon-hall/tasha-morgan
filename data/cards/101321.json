  "rulings": [
    {
      "text": "The minion need not attempt to block nor play further reaction cards: that is merely an option. [TOM 19951129]",
      "group": "Wake",
      "reminder": false,
      "references": [
        {
          "text": "[TOM 19951129]",
          "label": "TOM 19951129",
          "url": "https://usenet.krcg.org/t/jjBzopH-yrQ/#m3"
        }
      ],
      "cards": [],
      "symbols": []
    },
    {
      "text": "Can be played or used after action resolution (e.g. to use a reaction card like {100705|Fast Reaction} after combat). [LSJ 20091123]",
      "group": "Wake",
      "reminder": false,
      "references": [
        {
          "text": "[LSJ 20091123]",
          "label": "LSJ 20091123",
          "url": "https://usenet.krcg.org/t/Yt7LsvWFwiM/"
        }
      ],
      "cards": [
        {
          "id": 100705,
          "printed_name": "Fast Reaction",
          "unicity_suffix": "",
          "suffix": ""
        }
      ],
      "symbols": []
    },
    {
      "text": "Can be played or used during the “as a card is played” window, except in combat, or when there is no action. [ANK 20210817]",
      "group": "Wake",
      "reminder": false,
      "references": [
        {
          "text": "[ANK 20210817]",
          "label": "ANK 20210817",
          "url": "https://www.vekn.net/forum/rules-questions/79275-wake-cards-during-the-as-play-window-and-other-exotic-cancelling-effects?start=0#102931"
        }
      ],
      "cards": [],
      "symbols": []
    }
  ],
  "cards": [],
  "text": "Only usable by a locked minion. A minion can play only one On the Qui Vive between their unlock phases.\nThis minion wakes (they ignore the requirement to be unlocked for playing reaction cards and attempting to block until the end of the action). If this minion is an ally, they do not unlock as normal during their next unlock phase.",
