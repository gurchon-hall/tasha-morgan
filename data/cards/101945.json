  "i18n": {
    "es": {
      "name": "Saborear la Vitae",
      "text": "Sólo utilizable al final de un asalto de combate. No utilizable por un vampiro que se esté quemando o entrando en letargo. Un vampiro puede jugar sólo un ejemplar de esta carta por asalto.\nEste vampiro gana tanta sangre como sangre haya perdido el vampiro oponente debido al daño en este asalto.",
      "flavor": "",
      "draft": "",
      "url": "https://static.krcg.org/card/es/tasteofvitae.jpg",
      "cards": []
    },
    "fr": {
      "name": "Gorgée de vitæ",
      "text": "Seulement utilisable à la fin d'un round de combat. Non utilisable par un vampire en train d'être brûlé ou d'aller en torpeur. Un vampire ne peut en jouer qu'un seul exemplaire par round.\nCe vampire gagne autant de points de sang que de points de sang perdus par le vampire opposé à cause de dégâts ce round-ci.",
      "flavor": "",
      "draft": "",
      "url": "https://static.krcg.org/card/fr/tasteofvitae.jpg",
      "cards": []
    }
  },
