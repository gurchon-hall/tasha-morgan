  "rulings": [
    {
      "text": "Cannot be played against an ally. [PIB 20121028]",
      "group": "",
      "reminder": false,
      "references": [
        {
          "text": "[PIB 20121028]",
          "label": "PIB 20121028",
          "url": "https://www.vekn.net/forum/rules-questions/39816-ec-2012-can-you-answer-these?start=6#39843"
        }
      ],
      "cards": [],
      "symbols": []
    },
    {
      "text": "Must be played after the presses are handled and can be played if the round ends prematurely. [RTR 20001020] [LSJ 20001024] [RTR 20030519]",
      "group": "",
      "reminder": false,
      "references": [
        {
          "text": "[RTR 20001020]",
          "label": "RTR 20001020",
          "url": "https://usenet.krcg.org/t/GvxNYsYsWJ4/#m0"
        },
        {
          "text": "[LSJ 20001024]",
          "label": "LSJ 20001024",
          "url": "https://usenet.krcg.org/t/GvxNYsYsWJ4/#m6"
        },
        {
          "text": "[RTR 20030519]",
          "label": "RTR 20030519",
          "url": "https://usenet.krcg.org/t/NOBWXWrd-vA/#m0"
        }
      ],
      "cards": [],
      "symbols": []
    },
    {
      "text": "Can be played before or after effects that are played at the end of the round or \"when the combat would end\" (eg. [AUS] {101950|Telepathic Tracking}). Can be played after [CEL] {101507|Psyche!} [LSJ 20021113] [ANK 20191219] [ANK 20180910-1]",
      "group": "",
      "reminder": false,
      "references": [
        {
          "text": "[LSJ 20021113]",
          "label": "LSJ 20021113",
          "url": "https://usenet.krcg.org/t/df2P8YHZex8/#m11"
        },
        {
          "text": "[ANK 20191219]",
