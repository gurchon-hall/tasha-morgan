  "rulings": [
    {
      "text": "Is played after resolution, after all combats (if any) are handled, but still during the action. Action modifiers and effects that can be played \"after resolution\" can be played before or after it. [PIB 20150915] [LSJ 19981028] [ANK 20190425]",
      "group": "Played after resolution",
      "reminder": false,
      "references": [
        {
          "text": "[PIB 20150915]",
          "label": "PIB 20150915",
          "url": "https://www.vekn.net/forum/rules-questions/73134-learjet#73139"
        },
        {
          "text": "[LSJ 19981028]",
          "label": "LSJ 19981028",
          "url": "https://usenet.krcg.org/t/JZHY1bTCAa0/#m1"
        },
        {
          "text": "[ANK 20190425]",
          "label": "ANK 20190425",
          "url": "https://www.vekn.net/forum/rules-questions/77581-action-modifiers-played-at-beginning-and-end-of-an-action#94652"
        }
      ],
      "cards": [],
      "symbols": []
    },
    {
      "text": "Is played after the referendum is resolved. If the effect of the referendum ousts the acting Methuselah, there is no time to play it to prevent the ousting. [RTR 19951110]",
      "group": "Pool gain after referendum",
      "reminder": false,
      "references": [
        {
          "text": "[RTR 19951110]",
          "label": "RTR 19951110",
          "url": "https://usenet.krcg.org/t/TXfganI5B2o/#m0"
        }
      ],
      "cards": [],
      "symbols": []
    },
    {
      "text": "Can be used after a referendum that is automatically passing, but the vote is considered to have passed by 0 votes. [LSJ 19980107] [PIB 20150105]",
      "group": "Pool gain after referendum",
      "reminder": false,
      "references": [
        {
          "text": "[LSJ 19980107]",
          "label": "LSJ 19980107",
          "url": "https://usenet.krcg.org/t/aUUs4VCR_Ec/#m1"
        },
        {
          "text": "[PIB 20150105]",
          "label": "PIB 20150105",
          "url": "https://www.vekn.net/forum/rules-questions/68465-voting-is-complicated#68493"
        }
      ],
      "cards": [],
      "symbols": []
    }
  ],
  "cards": [],
  "text": "Only usable after resolution of a political action whose referendum passed.\n[pre] This vampire gains 1 blood for each vote by which the referendum passed.\n[PRE] As above, but move up to 2 of those blood to your pool instead of this vampire.",
