  "i18n": {
    "es": {
      "name": "Segunda tradición: El Dominio",
      "text": "Requiere a un príncipe o justicar.\n+2 de intercepción. También utilizable por un príncipe o justicar girado, aunque aún no se necesite intercepción, para quemar 1 de sangre para enderezarse e intentar bloquear con +2 de intercepción.",
      "flavor": "Nadie podrá desafiar tu juicio mientras se halle en tu dominio.",
      "draft": "",
      "url": "https://static.krcg.org/card/es/secondtraditiondomain.jpg",
      "cards": []
    },
    "fr": {
      "name": "Deuxième Tradition : le Domaine",
      "text": "Requiert un prince ou justicar.\n+2 en interception. Utilisable également par un prince ou justicar incliné, même si de l'interception n'est pas encore nécessaire, pour brûler 1 point de sang pour se redresser et tenter de bloquer avec +2 en interception.",
      "flavor": "Nul ne peut mettre en doute ta parole en ton domaine.",
      "draft": "",
      "url": "https://static.krcg.org/card/fr/secondtraditiondomain.jpg",
      "cards": []
    }
  },
