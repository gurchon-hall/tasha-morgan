  "rulings": [
    {
      "text": "The burn blood effect is not reduced by effects that reduce the cost of the card (eg. {200011|Adana de Sforza}). [ANK 20210226]",
      "group": "Burn blood for effect",
      "reminder": false,
      "references": [
        {
          "text": "[ANK 20210226]",
          "label": "ANK 20210226",
          "url": "https://www.vekn.net/forum/rules-questions/79045-paths-and-burn-blood-requrement?start=18#101726"
        }
      ],
      "cards": [
        {
          "id": 200011,
          "printed_name": "Adana de Sforza",
          "unicity_suffix": "",
          "suffix": "G4"
        }
      ],
      "symbols": []
    },
    {
      "text": "The card cannot be played if the minion cannot afford to burn the blood. [ANK 20210226]",
      "group": "Burn blood for effect (mandatory)",
      "reminder": false,
      "references": [
        {
          "text": "[ANK 20210226]",
          "label": "ANK 20210226",
          "url": "https://www.vekn.net/forum/rules-questions/79045-paths-and-burn-blood-requrement?start=18#101726"
        }
      ],
      "cards": [],
      "symbols": []
    },
    {
      "text": "If the action lacks a suitable target because of the unlock (e.g. {100046|Ambush}), the block attempt still happens, as does the resulting combat if the block is successful. [LSJ 20090514]",
      "group": "Unlocks and attempts to block",
      "reminder": false,
      "references": [
        {
          "text": "[LSJ 20090514]",
          "label": "LSJ 20090514",
          "url": "https://usenet.krcg.org/t/PKQ6lQUBUOI/#m1"
        }
      ],
      "cards": [
