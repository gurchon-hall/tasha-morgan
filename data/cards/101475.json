  "i18n": {
    "es": {
      "name": "Precognición",
      "text": "[aus] +1 de intercepción.\n[AUS] Como antes, y este vampiro puede prevenirse de 1 de daño durante el primer asalto del combate resultante si bloquea.",
      "flavor": "\"Mala memoria, la que sólo funciona hacia atrás\", censuró la Reina.\nLewis Carroll, \"A través del espejo\"",
      "draft": "",
      "url": "https://static.krcg.org/card/es/precognition.jpg",
      "cards": []
    },
    "fr": {
      "name": "Précognition",
      "text": "[aus] +1 en interception.\n[AUS] Comme ci-dessus et ce vampire peut prévenir 1 point de dégâts durant le premier round du combat résultant s'il bloque.",
      "flavor": "\"Une mémoire qui n'opère que dans le passé n'a rien de bien fameux\", déclara la Reine.\nLewis Carroll, \"De l'autre côté du miroir\"",
      "draft": "",
      "url": "https://static.krcg.org/card/fr/precognition.jpg",
      "cards": []
    }
