  "i18n": {
    "es": {
      "name": "Seducción",
      "text": "Sólo utilizable al anunciar la acción.\n[dom] Elige a un vampiro menor. El vampiro elegido no puede bloquear esta acción.\n[DOM] Como antes, pero elige a cualquier vampiro.",
      "flavor": "Dejarse llevar es el secreto; renunciar a mí es el mayor placer de todos...\nRobbi Sommers, \"Lilit\"",
      "draft": "",
      "url": "https://static.krcg.org/card/es/seduction.jpg",
      "cards": []
    },
    "fr": {
      "name": "Séduction",
      "text": "Seulement utilisable lors de l'annonce de l'action.\n[dom] Choisissez un vampire plus jeune. Le vampire choisi ne peut pas bloquer cette action.\n[DOM] Comme ci-dessus, mais choisissez n'importe quel vampire.",
      "flavor": "Se relâcher est le secret ; s'abandonner à moi est le plus grand plaisir de tous...\nRobbi Sommers, \"Lilit\"",
      "draft": "",
      "url": "https://static.krcg.org/card/fr/seduction.jpg",
      "cards": []
    }
