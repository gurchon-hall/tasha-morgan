  "i18n": {
    "es": {
      "name": "Fama",
      "text": "Única.\nPonle esta carta a un vampiro preparado. El controlador de este vampiro quema 3 de reserva sanguínea después de que este vampiro entre en letargo. Durante la fase de enderezamiento de cada Matusalén, si este vampiro está en letargo, ese Matusalén quema 1 de reserva sanguínea.",
      "flavor": "",
      "draft": "",
      "url": "https://static.krcg.org/card/es/fame.jpg",
      "cards": []
    },
    "fr": {
      "name": "Renommée",
      "text": "Unique.\nMettez cette carte sur un vampire disponible. Le contrôleur de ce vampire brûle 3 points de réserve après que ce vampire va en torpeur. Durant la phase de redressement de chaque Mathusalem, si ce vampire est en torpeur, ce Mathusalem brûle 1 point de réserve.",
      "flavor": "",
      "draft": "",
      "url": "https://static.krcg.org/card/fr/fame.jpg",
